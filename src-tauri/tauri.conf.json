{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIHome",
  "version": "0.3.0",
  "identifier": "com.justinju.aihome",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../standalone-resources"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AIHome",
        "url": "http://127.0.0.1:3010",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640
      },
      {
        "label": "widget",
        "title": "AIHome Widget",
        "url": "http://127.0.0.1:3010/widget",
        "width": 320,
        "height": 480,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:3010; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "trayIcon": { "id": "main-tray", "iconPath": "icons/tray.png", "tooltip": "AIHome" }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Agent ecosystem workspace",
    "resources": { "../standalone-resources/standalone": "standalone" }
  }
}
